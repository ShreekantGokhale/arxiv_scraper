# Copy this file to .env and fill in your values. .env is git-ignored.

# MySQL connection. Special characters in the password (@ : / # spaces) are fine here.
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arxiv

# Alternatively, one URL (overrides the DB_* settings; special characters must be %-encoded):
# DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/arxiv?charset=utf8mb4

# Optional: free key from https://www.semanticscholar.org/product/api
S2_API_KEY=
